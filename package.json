{
  "name": "scheduler-overlap-preventer",
  "version": "1.0.0",
  "description": "Single-concurrency task scheduling wrapper for Node.js to prevent overlapping runs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "scheduler",
    "cron",
    "interval",
    "overlap",
    "prevent-overlap",
    "mutex",
    "concurrency-control",
    "single-instance"
  ],
  "author": "Antigravity Factory Manager",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
